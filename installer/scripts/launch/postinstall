#!/bin/sh
# Exécuté en root par l'installateur : on agit au nom de l'utilisateur connecté, jamais en root.
USER_NAME=$(/usr/bin/stat -f%Su /dev/console)
USER_HOME=$(/usr/bin/dscl . -read "/Users/$USER_NAME" NFSHomeDirectory | /usr/bin/awk '{print $2}')
APP=/Applications/pet-claude.app/Contents/MacOS/app
LOG=/tmp/pet-claude-install.log
as_user() { /usr/bin/sudo -u "$USER_NAME" env HOME="$USER_HOME" "$@" >>"$LOG" 2>&1; }
# lance le pet dans la session graphique de l'utilisateur, après la configuration
/bin/launchctl asuser "$(/usr/bin/id -u "$USER_NAME")" /usr/bin/sudo -u "$USER_NAME" /usr/bin/open /Applications/pet-claude.app >>"$LOG" 2>&1
exit 0
